# ═══════════════════════════════════════════════════════════════════════════
# Yobante Boutique Backend - Configuration Environnement
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Clustering (Multi-Process) ──────────────────────────────────────────
# Nombre de workers pour utiliser les CPUs en parallèle
# En dev: 1 (default), en prod: 2-4 selon les vCPU disponibles
# ⚠️  IMPORTANT: Chaque worker utilise ~50-100MB de RAM
# Si server a 512MB: garder CLUSTER_WORKERS=1
# Si server a 2GB+: passer à CLUSTER_WORKERS=2 ou 4
CLUSTER_WORKERS=1

# ─── Base de données PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yobante_boutique
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=false
# DB_SSL=true  # Activer en production

# ─── JWT - Secrets d'authentification ─────────────────────────────────────
# ⚠️  IMPORTANT: Les trois secrets DOIVENT être différents
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=change_me_with_secure_random_secret
JWT_REFRESH_SECRET=change_me_with_different_secure_random_secret
JWT_RESET_SECRET=change_me_with_another_different_secure_random_secret
JWT_EXPIRES_IN=1h

# ─── CORS - Origins autorisées ────────────────────────────────────────────
# Format: liste séparée par virgules (pas d'espaces)
# Ex: http://localhost:3000,https://app.yobante.com

CORS_ORIGIN=http://localhost:3000

# ⚠️  JAMAIS CORS_ORIGIN=* en production!

# ─── Cloudflare R2 - Image Upload ────────────────────────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=yobante
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── Email - Resend Service ──────────────────────────────────────────────
# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
# Expéditeur : le domaine doit être vérifié dans Resend.
# Pour tester sans domaine vérifié : "Yobante Boutique <onboarding@resend.dev>"
MAIL_FROM=Yobante Boutique <noreply@yobante.com>
# URL affichée dans les emails (lien de connexion envoyé aux vendeurs créés)
FRONTEND_URL=http://localhost:3000
# Lien de connexion envoyé aux administrateurs créés depuis le dashboard
ADMIN_URL=https://admin.yobanterek.com

# ─── Admin Initial (Seeder) ──────────────────────────────────────────────
# ⚠️  CHANGER avant production!

ADMIN_EMAIL=admin@yobante.com
ADMIN_PASSWORD=Admin1234!
ADMIN_NOM=Admin
ADMIN_PRENOM=Yobante

# ─── Frais de livraison par défaut (en cas d'absence dans la table FraisLivraison) ──
FRAIS_LIVRAISON_DEFAUT=15

# ─── Paiement - Wave ───────────────────────────────────────────────────────
# Configuration Wave API (https://developer.wave.com)
# ⚠️  OBLIGATOIRE pour accepter les paiements Wave
WAVE_API_KEY=your_wave_api_key
WAVE_API_SECRET=your_wave_api_secret
WAVE_API_URL=https://api.wave.com/v1

# ─── Paiement - Orange Money ──────────────────────────────────────────────
# Configuration Orange Money API (https://orange.cm/business/orangemoney/)
# ⚠️  OBLIGATOIRE pour accepter les paiements Orange Money
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_SECRET=your_orange_money_api_secret
ORANGE_MONEY_MERCHANT_ID=your_merchant_id
ORANGE_MONEY_API_URL=https://api.orange.com/orangemoney

# ─── URL Publique API ──────────────────────────────────────────────────────
# Utilisée pour construire les URLs de callback paiement
# En dev: http://localhost:5000
# En prod: https://api.yobante.com
API_PUBLIC_URL=http://localhost:5000

# ─── Pool PostgreSQL ──────────────────────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─── Versioning API ───────────────────────────────────────────────────────────
# Toutes les routes sont maintenant sous /api/v1/*

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════════════════════
# CHECKLIST DE DÉPLOIEMENT PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════
#
# ☐ NODE_ENV=production
# ☐ CLUSTER_WORKERS=2 (ou plus selon vCPU/RAM disponibles)
# ☐ JWT_SECRET, JWT_REFRESH_SECRET, JWT_RESET_SECRET = valeurs fortes & uniques
# ☐ ADMIN_EMAIL et ADMIN_PASSWORD changés (pas les valeurs par défaut)
# ☐ DB_SSL=true et DB_HOST pointant vers DB prod
# ☐ CORS_ORIGIN = domaines réels (jamais *)
# ☐ CLOUDINARY_* et RESEND_API_KEY configurés
# ☐ .env.example commité, .env NON commité
# ☐ Variables d'environnement définis sur le serveur (Render, Railway, etc)
#
# ═══════════════════════════════════════════════════════════════════════════
